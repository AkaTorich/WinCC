<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>7.3</LangVersion>
    <Version>1.3.1</Version>
    <AssemblyName>WinCC</AssemblyName>
    <RootNamespace>WinCC</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\</OutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <ApplicationIcon>icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="icon.ico" />
    <Reference Include="System.Drawing" />
    <!-- встроенные заголовки wcc: из них подсказки ввода берут имена stdio.h, string.h… (Editor\Completion\Symbols.cs) -->
    <EmbeddedResource Include="..\compiler\headers.c" LogicalName="headers.c" />
    <Compile Remove="tools\**" />
    <None Remove="tools\**" />
  </ItemGroup>
  <!-- Библиотека тем вшивается исходниками: все её темы на борту, программа остаётся одним exe -->
  <Import Project="..\..\Libraries\ThemeLibrary\ThemeLibrary.Source.props" />
  <!-- Готовый WinCC.exe кладётся в корень WinCC\, рядом с wcc.exe -->
  <Target Name="CopyExeToRoot" AfterTargets="Build">
    <Copy SourceFiles="$(OutDir)WinCC.exe" DestinationFolder="$(MSBuildProjectDirectory)\.." />
  </Target>
</Project>
