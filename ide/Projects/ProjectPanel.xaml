<UserControl x:Class="WinCC.Projects.ProjectPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tl="clr-namespace:ThemeLibrary"
             AllowDrop="True">
    <UserControl.Resources>
        <Style x:Key="PanelButton" TargetType="Button" BasedOn="{StaticResource Theme.IconButton}">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
        <Style x:Key="PanelIcon" TargetType="tl:Icon">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Открытый проект -->
        <DockPanel x:Name="ProjectView" Visibility="Collapsed">
            <DockPanel DockPanel.Dock="Top" Margin="6,2,2,2" LastChildFill="True">
                <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{StaticResource PanelButton}" ToolTip="Закрыть проект">
                    <tl:Icon Kind="Close" Style="{StaticResource PanelIcon}"/>
                </Button>
                <tl:Icon Kind="Layers" Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center"
                         Foreground="{DynamicResource Theme.Accent}"/>
                <TextBlock x:Name="NameText" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,0,2,6">
                <Button x:Name="AddButton" Style="{StaticResource PanelButton}" ToolTip="Добавить файлы в проект">
                    <tl:Icon Kind="Plus" Style="{StaticResource PanelIcon}"/>
                </Button>
                <Button x:Name="NewFileButton" Style="{StaticResource PanelButton}" ToolTip="Новый файл в проекте">
                    <tl:Icon Kind="File" Style="{StaticResource PanelIcon}"/>
                </Button>
                <Button x:Name="PropertiesButton" Style="{StaticResource PanelButton}" ToolTip="Свойства проекта">
                    <tl:Icon Kind="Settings" Style="{StaticResource PanelIcon}"/>
                </Button>
            </StackPanel>
            <TextBlock x:Name="OutputText" DockPanel.Dock="Bottom" Margin="8,6,6,2" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource Theme.TextDim}"/>
            <Grid>
                <TreeView x:Name="Tree"/>
                <StackPanel x:Name="NoFilesView" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10" Visibility="Collapsed">
                    <TextBlock Text="В проекте нет файлов" Foreground="{DynamicResource Theme.TextDim}" HorizontalAlignment="Center"/>
                    <Button x:Name="NoFilesAddButton" Content="Добавить файлы…" Style="{DynamicResource Theme.Button}"
                            Padding="12,5" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </DockPanel>

        <!-- Проекта нет -->
        <DockPanel x:Name="EmptyView" Margin="6,2,6,4">
            <StackPanel DockPanel.Dock="Top">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <tl:Icon Kind="Layers" Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center"
                             Foreground="{DynamicResource Theme.TextDim}"/>
                    <TextBlock Text="Проект не открыт" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <Button x:Name="NewProjectButton" Style="{DynamicResource Theme.Button}" Padding="10,5" Margin="0,0,0,6"
                        HorizontalContentAlignment="Left">
                    <StackPanel Orientation="Horizontal"><tl:Icon Kind="Plus" Width="14" Height="14" Margin="0,0,7,0"/><TextBlock Text="Новый проект…"/></StackPanel>
                </Button>
                <Button x:Name="OpenProjectButton" Style="{DynamicResource Theme.Button}" Padding="10,5"
                        HorizontalContentAlignment="Left">
                    <StackPanel Orientation="Horizontal"><tl:Icon Kind="FolderOpen" Width="14" Height="14" Margin="0,0,7,0"/><TextBlock Text="Открыть проект…"/></StackPanel>
                </Button>
                <TextBlock x:Name="RecentTitle" Text="Недавние" Foreground="{DynamicResource Theme.TextDim}" Margin="2,16,0,4"/>
            </StackPanel>
            <ListBox x:Name="RecentList" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
        </DockPanel>
    </Grid>
</UserControl>
