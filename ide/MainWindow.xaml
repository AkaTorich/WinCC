<tl:ThemedWindow x:Class="WinCC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tl="clr-namespace:ThemeLibrary"
        xmlns:pr="clr-namespace:WinCC.Projects"
        Title="WinCC" Subtitle="{DynamicResource S.Subtitle}" Icon="icon.ico"
        Width="1280" Height="820" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" AllowDrop="True">

    <tl:ThemedWindow.Resources>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Theme.Card.Background}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Card.Border}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource Theme.Card.BorderThickness}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Theme.Card.CornerRadius}"/>
        </Style>
        <Style x:Key="ButtonIcon" TargetType="tl:Icon">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- Вкладки файлов и нижней панели: плоская полоса без лишнего места; выбранная — фон и черта акцента снизу -->
        <Style x:Key="CompactTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource Theme.Tab.Foreground}"/>
            <Setter Property="FontSize" Value="{DynamicResource Theme.FontSize.Small}"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="7,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="3,3,0,0"/>
                            <Border x:Name="line" Height="2" VerticalAlignment="Bottom" Opacity="0"
                                    Background="{DynamicResource Theme.Tab.Indicator}"/>
                            <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme.Item.Hover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Panel.ZIndex" Value="1"/>
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme.Tab.Selected}"/>
                                <Setter TargetName="line" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="{DynamicResource Theme.Tab.SelectedForeground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CompactTabs" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource CompactTab}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local" SnapsToDevicePixels="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border BorderBrush="{DynamicResource Theme.Separator}" BorderThickness="0,0,0,1">
                                <TabPanel IsItemsHost="True" Panel.ZIndex="1" Margin="0,0,0,-1" KeyboardNavigation.TabIndex="1"/>
                            </Border>
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource Theme.Button}">
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>
    </tl:ThemedWindow.Resources>

    <Grid Margin="10,4,10,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Кнопки -->
        <Border Grid.Row="0" Style="{StaticResource Panel}" Padding="8,7" Margin="0,0,0,8">
            <!-- Группы кнопок переносятся на вторую строку, когда окно узкое -->
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button x:Name="SettingsButton" Style="{StaticResource ToolButton}" Padding="9,6"
                            ToolTip="{DynamicResource S.SettingsTip}">
                        <tl:Icon Kind="Settings" Width="16" Height="16" VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="HelpButton" Style="{StaticResource ToolButton}" Padding="9,6" Margin="0,0,14,0"
                            ToolTip="{DynamicResource S.HelpTip}">
                        <tl:Icon Kind="Book" Width="16" Height="16" VerticalAlignment="Center"/>
                    </Button>
                    <tl:Icon x:Name="CompilerIcon" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="CompilerText" VerticalAlignment="Center" Margin="0,0,4,0"/>
                </StackPanel>
                <WrapPanel Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <ToggleButton x:Name="ProjectButton" Style="{DynamicResource Theme.ToggleButton}" Margin="0,0,6,0" Padding="12,6"
                                      ToolTip="{DynamicResource S.ProjectTip}">
                            <StackPanel Orientation="Horizontal"><tl:Icon Kind="Layers" Style="{StaticResource ButtonIcon}"/><TextBlock Text="{DynamicResource S.Project}"/></StackPanel>
                        </ToggleButton>
                        <Button x:Name="NewButton" Style="{StaticResource ToolButton}" ToolTip="{DynamicResource S.NewTip}">
                            <StackPanel Orientation="Horizontal"><tl:Icon Kind="File" Style="{StaticResource ButtonIcon}"/><TextBlock Text="{DynamicResource S.New}"/></StackPanel>
                        </Button>
                        <Button x:Name="OpenButton" Style="{StaticResource ToolButton}" ToolTip="{DynamicResource S.OpenTip}">
                            <StackPanel Orientation="Horizontal"><tl:Icon Kind="FolderOpen" Style="{StaticResource ButtonIcon}"/><TextBlock Text="{DynamicResource S.Open}"/></StackPanel>
                        </Button>
                        <Button x:Name="SaveButton" Style="{StaticResource ToolButton}" ToolTip="{DynamicResource S.SaveTip}">
                            <StackPanel Orientation="Horizontal"><tl:Icon Kind="Save" Style="{StaticResource ButtonIcon}"/><TextBlock Text="{DynamicResource S.Save}"/></StackPanel>
                        </Button>
                        <Rectangle Width="1" Margin="6,4,12,4" Fill="{DynamicResource Theme.TextDim}" Opacity="0.35"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <Button x:Name="BuildButton" Style="{StaticResource ToolButton}" ToolTip="{DynamicResource S.BuildTip}">
                            <StackPanel Orientation="Horizontal"><tl:Icon Kind="Wrench" Style="{StaticResource ButtonIcon}"/><TextBlock Text="{DynamicResource S.Build}"/></StackPanel>
                        </Button>
                        <Button x:Name="RunButton" Style="{StaticResource ToolButton}" ToolTip="{DynamicResource S.RunTip}">
                            <StackPanel Orientation="Horizontal"><tl:Icon Kind="SkipForward" Style="{StaticResource ButtonIcon}"/><TextBlock Text="{DynamicResource S.Run}"/></StackPanel>
                        </Button>
                        <Button x:Name="DebugButton" Style="{DynamicResource Theme.AccentButton}" Margin="0,0,6,0" Padding="12,6" ToolTip="{DynamicResource S.DebugTip}">
                            <StackPanel Orientation="Horizontal"><tl:Icon Kind="Play" Style="{StaticResource ButtonIcon}"/><TextBlock x:Name="DebugText" Text="{DynamicResource S.Debug}"/></StackPanel>
                        </Button>
                        <!-- Шаги отладки: видны, пока программа под отладчиком -->
                        <StackPanel x:Name="DebugBar" Orientation="Horizontal" Visibility="Collapsed">
                            <Button x:Name="StopButton" Style="{StaticResource ToolButton}" Padding="9,6" ToolTip="{DynamicResource S.StopTip}">
                                <tl:Icon Kind="Stop" Width="16" Height="16" VerticalAlignment="Center"/>
                            </Button>
                            <Button x:Name="StepOverButton" Style="{StaticResource ToolButton}" Padding="9,6" ToolTip="{DynamicResource S.StepOverTip}">
                                <tl:Icon Kind="ArrowRight" Width="16" Height="16" VerticalAlignment="Center"/>
                            </Button>
                            <Button x:Name="StepIntoButton" Style="{StaticResource ToolButton}" Padding="9,6" ToolTip="{DynamicResource S.StepIntoTip}">
                                <tl:Icon Kind="ArrowDown" Width="16" Height="16" VerticalAlignment="Center"/>
                            </Button>
                            <Button x:Name="StepOutButton" Style="{StaticResource ToolButton}" Padding="9,6" ToolTip="{DynamicResource S.StepOutTip}">
                                <tl:Icon Kind="ArrowUp" Width="16" Height="16" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                        <Rectangle Width="1" Margin="6,4,12,4" Fill="{DynamicResource Theme.TextDim}" Opacity="0.35"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <ComboBox x:Name="ConfigBox" Width="104" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="{DynamicResource S.ConfigTip}"/>
                        <TextBlock Text="{DynamicResource S.KindLabel}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource Theme.TextDim}"/>
                        <ComboBox x:Name="KindBox" Width="130" VerticalAlignment="Center" ToolTip="{DynamicResource S.KindTip}"/>
                    </StackPanel>
                </WrapPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ProjectColumn" Width="0"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="360"/>
            </Grid.ColumnDefinitions>

            <!-- Проект -->
            <Border x:Name="ProjectBorder" Grid.Column="0" Style="{StaticResource Panel}" Padding="6,8,6,6" Visibility="Collapsed">
                <pr:ProjectPanel x:Name="ProjectSide"/>
            </Border>
            <GridSplitter x:Name="ProjectSplitter" Grid.Column="1" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Focusable="False"
                          Visibility="Collapsed"/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="EditorRow" Height="*" MinHeight="120"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition x:Name="BottomRow" Height="0.36*" MinHeight="120"/>
                </Grid.RowDefinitions>

                <!-- Файлы -->
                <Border Grid.Row="0" Style="{StaticResource Panel}" Padding="4">
                    <Grid>
                        <TabControl x:Name="Docs" Style="{StaticResource CompactTabs}"/>
                        <StackPanel x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                            <tl:Icon Kind="Code" Width="44" Height="44" Foreground="{DynamicResource Theme.TextDim}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource S.NoOpenFiles}" Style="{DynamicResource Theme.H2}" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                            <TextBlock Text="{DynamicResource S.NoOpenFilesHint}"
                                       Foreground="{DynamicResource Theme.TextDim}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                                <Button x:Name="HintNewButton" Content="{DynamicResource S.NewFile}" Style="{StaticResource ToolButton}"/>
                                <Button x:Name="HintOpenButton" Content="{DynamicResource S.OpenEllipsis}" Style="{StaticResource ToolButton}" Margin="0"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              Background="Transparent" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Focusable="False"/>

                <!-- Вывод компилятора и список ошибок -->
                <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="4">
                    <TabControl x:Name="BottomTabs" Style="{StaticResource CompactTabs}">
                        <TabItem x:Name="OutputTab">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal"><tl:Icon Kind="FileText" Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center"/><TextBlock Text="{DynamicResource S.Output}"/></StackPanel>
                            </TabItem.Header>
                            <TextBox x:Name="OutputBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                     FontFamily="{DynamicResource Theme.Font.Mono}" FontSize="13" BorderThickness="0"
                                     ToolTip="{DynamicResource S.OutputTip}"/>
                        </TabItem>
                        <TabItem x:Name="ErrorsTab">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal"><tl:Icon Kind="Warning" Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center"/><TextBlock x:Name="ErrorsHeader" Text="Errors"/></StackPanel>
                            </TabItem.Header>
                            <Grid>
                                <ListView x:Name="ErrorList" BorderThickness="0">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="" Width="34">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <tl:Icon x:Name="mark" Kind="Error" Width="14" Height="14" Foreground="{DynamicResource Theme.Danger}"/>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                                <Setter TargetName="mark" Property="Kind" Value="Warning"/>
                                                                <Setter TargetName="mark" Property="Foreground" Value="{DynamicResource Theme.Warning}"/>
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="{DynamicResource S.ColFile}" Width="170" DisplayMemberBinding="{Binding FileName}"/>
                                            <GridViewColumn Header="{DynamicResource S.ColLine}" Width="84" DisplayMemberBinding="{Binding LineText}"/>
                                            <GridViewColumn Header="{DynamicResource S.ColMessage}" Width="520" DisplayMemberBinding="{Binding Text}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                                <TextBlock x:Name="NoErrorsText" Text="{DynamicResource S.NoErrors}" Foreground="{DynamicResource Theme.TextDim}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            </Grid>
                        </TabItem>
                        <TabItem x:Name="VarsTab">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal"><tl:Icon Kind="List" Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center"/><TextBlock Text="{DynamicResource S.Variables}"/></StackPanel>
                            </TabItem.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Margin="28,4,0,4" TextElement.Foreground="{DynamicResource Theme.TextDim}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="460"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource S.ColName}"/>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource S.ColValue}"/>
                                    <TextBlock Grid.Column="2" Text="{DynamicResource S.ColType}"/>
                                </Grid>
                                <TreeView x:Name="VarTree" Grid.Row="1" BorderThickness="0" FontFamily="{DynamicResource Theme.Font.Mono}" FontSize="13"/>
                                <TextBlock x:Name="NoVarsText" Grid.Row="1" Text="{DynamicResource S.NoVariables}" Foreground="{DynamicResource Theme.TextDim}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            </Grid>
                        </TabItem>
                        <TabItem x:Name="StackTab">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal"><tl:Icon Kind="Layers" Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center"/><TextBlock Text="{DynamicResource S.CallStack}"/></StackPanel>
                            </TabItem.Header>
                            <ListView x:Name="StackList" BorderThickness="0">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="{DynamicResource S.ColFunction}" Width="260" DisplayMemberBinding="{Binding Function}"/>
                                        <GridViewColumn Header="{DynamicResource S.ColPlace}" Width="560" DisplayMemberBinding="{Binding Place}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>
        </Grid>

        <!-- Строка состояния -->
        <DockPanel Grid.Row="2" Margin="4,7,4,0" LastChildFill="True">
            <TextBlock x:Name="KindStatus" DockPanel.Dock="Right" Foreground="{DynamicResource Theme.TextDim}" Margin="18,0,0,0"/>
            <TextBlock x:Name="EncodingStatus" DockPanel.Dock="Right" Foreground="{DynamicResource Theme.TextDim}" Margin="18,0,0,0"/>
            <TextBlock x:Name="CaretStatus" DockPanel.Dock="Right" Foreground="{DynamicResource Theme.TextDim}" Margin="18,0,0,0"/>
            <TextBlock x:Name="PathStatus" Foreground="{DynamicResource Theme.TextDim}" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
</tl:ThemedWindow>
