// Resources of tests\win_res.c: every kind wcc knows. res\compare.ps1 compiles it with rc.exe too.
#pragma code_page(65001)
#include <winres.h>
#include "win_res.h"

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

IDI_TEST    ICON    "res\\test.ico"
IDC_TEST    CURSOR  DISCARDABLE "res/test.cur"
IDB_TEST    BITMAP  "res\\test.bmp"
IDR_FILE    RCDATA  "res\\data.bin"
NAMED_ICON  ICON    "res\\test.ico"

IDR_INLINE RCDATA
BEGIN
    0x1234, 7L, "abc", L"Жж", 255
END

IDR_OWN TESTDATA
BEGIN
    1, 2, 3
END

"QUOTED" 300 "res\\data.bin"

STRINGTABLE
BEGIN
    IDS_HELLO,  "Привет, мир!"
    IDS_SECOND  "Second ""quoted"" line"
    IDS_FAR,    L"Строка 1000\tс табом"
    IDS_EMPTY,  ""
END

LANGUAGE LANG_RUSSIAN, SUBLANG_RUSSIAN_RUSSIA
STRINGTABLE
BEGIN
    IDS_HELLO,  "Здравствуй"
END
LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,2,3,4
 PRODUCTVERSION 5,6,7,8
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904b0"
        BEGIN
            VALUE "CompanyName", "WinCC"
            VALUE "FileDescription", "Проверка ресурсов"
            VALUE "FileVersion", "1.2.3.4"
            VALUE "ProductName", "WinCC"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x419, 1200
    END
END

IDM_MAIN MENU
BEGIN
    POPUP "&Файл"
    BEGIN
        MENUITEM "&Открыть\tCtrl+O", IDM_OPEN
        MENUITEM SEPARATOR
        MENUITEM "В&ыход", IDM_EXIT, GRAYED
    END
    MENUITEM "&Справка", IDM_HELP, CHECKED
END

IDM_EX MENUEX
BEGIN
    POPUP "Вид", 200, MFT_STRING, MFS_ENABLED
    BEGIN
        MENUITEM "Крупно", IDM_BIG, MFT_STRING, MFS_CHECKED
        MENUITEM "", 0, MFT_SEPARATOR
        MENUITEM "Мелко", IDM_SMALL
    END
END

IDA_MAIN ACCELERATORS
BEGIN
    "^O",   IDM_OPEN
    "q",    IDM_EXIT, ASCII
    VK_F1,  IDM_HELP, VIRTKEY
    "S",    IDM_SAVE, VIRTKEY, CONTROL, SHIFT
END

IDD_EX DIALOGEX 10, 20, 200, 90
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_TOOLWINDOW
CAPTION "Окно проверки"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Имя:", IDC_STATIC, 7, 9, 30, 8
    EDITTEXT        IDC_NAME, 40, 7, 150, 14, ES_AUTOHSCROLL
    AUTOCHECKBOX    "Флажок", IDC_CHECK, 7, 28, 80, 10
    COMBOBOX        IDC_LIST, 100, 28, 90, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Своё", IDC_CUSTOM, "Button", BS_AUTORADIOBUTTON | WS_GROUP, 7, 44, 60, 10
    ICON            IDI_TEST, IDC_ICON, 170, 44, 20, 20
    DEFPUSHBUTTON   "ОК", IDOK, 86, 70, 50, 14
    PUSHBUTTON      "Отмена", IDCANCEL, 143, 70, 50, 14, NOT WS_TABSTOP
END

IDD_OLD DIALOG 0, 0, 120, 40
STYLE WS_POPUP | WS_CAPTION
CAPTION "Old"
FONT 8, "MS Shell Dlg"
BEGIN
    CTEXT "Старый вид", IDC_STATIC, 5, 5, 110, 10
    PUSHBUTTON "ОК", IDOK, 35, 20, 50, 14
END
