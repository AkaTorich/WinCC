<tl:ThemedWindow x:Class="WinCC.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tl="clr-namespace:ThemeLibrary"
        Title="{DynamicResource S.Title}" Subtitle="{DynamicResource S.Subtitle}"
        Width="760" Height="570" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True">

    <tl:ThemedWindow.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Theme.Card.Background}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Card.Border}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource Theme.Card.BorderThickness}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Theme.Card.CornerRadius}"/>
            <Setter Property="Padding" Value="18,14"/>
        </Style>
        <Style x:Key="Feature" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,0,22,0"/>
        </Style>
        <Style x:Key="FeatureIcon" TargetType="tl:Icon">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Accent}"/>
        </Style>
        <Style x:Key="Option" TargetType="CheckBox" BasedOn="{StaticResource Theme.Switch}">
            <Setter Property="Margin" Value="0,7"/>
        </Style>
        <Style x:Key="BarButton" TargetType="Button" BasedOn="{StaticResource Theme.Button}">
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="MinWidth" Value="120"/>
        </Style>
    </tl:ThemedWindow.Resources>

    <Grid Margin="18,6,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка: значок, имя, версия, что умеет -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="20,18">
            <StackPanel>
                <DockPanel>
                    <Image x:Name="Logo" Width="64" Height="64" Margin="0,0,18,0" DockPanel.Dock="Left"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="WinCC" Style="{DynamicResource Theme.H1}"/>
                            <Border Background="{DynamicResource Theme.Accent}" CornerRadius="9" Padding="9,2"
                                    Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="VersionText" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource S.Tagline}"
                                   Foreground="{DynamicResource Theme.TextDim}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
                <WrapPanel Margin="0,16,0,0">
                    <StackPanel Style="{StaticResource Feature}">
                        <tl:Icon Kind="Code" Style="{StaticResource FeatureIcon}"/>
                        <TextBlock Text="{DynamicResource S.FeatEditor}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource Feature}">
                        <tl:Icon Kind="Wrench" Style="{StaticResource FeatureIcon}"/>
                        <TextBlock Text="{DynamicResource S.FeatWcc}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource Feature}">
                        <tl:Icon Kind="Layers" Style="{StaticResource FeatureIcon}"/>
                        <TextBlock Text="{DynamicResource S.FeatDll}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource Feature}">
                        <tl:Icon Kind="Shield" Style="{StaticResource FeatureIcon}"/>
                        <TextBlock Text="{DynamicResource S.FeatNoAdmin}" VerticalAlignment="Center"/>
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Страница 1: куда и что -->
        <Border x:Name="PageOptions" Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="{DynamicResource S.WhereTitle}" Style="{DynamicResource Theme.H2}"/>
                <DockPanel Margin="0,8,0,4">
                    <Button x:Name="BrowseButton" DockPanel.Dock="Right" Style="{StaticResource BarButton}" MinWidth="0" Click="Browse_Click">
                        <StackPanel Orientation="Horizontal">
                            <tl:Icon Kind="FolderOpen" Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource S.Browse}"/>
                        </StackPanel>
                    </Button>
                    <TextBox x:Name="FolderBox" VerticalContentAlignment="Center" Padding="8,6"/>
                </DockPanel>
                <TextBlock x:Name="InstalledText" Foreground="{DynamicResource Theme.TextDim}" FontSize="12" TextWrapping="Wrap"/>

                <UniformGrid Columns="2" Margin="0,12,0,0">
                    <CheckBox x:Name="DesktopBox" Style="{StaticResource Option}" IsChecked="True" Content="{DynamicResource S.OptDesktop}"/>
                    <CheckBox x:Name="StartBox" Style="{StaticResource Option}" IsChecked="True" Content="{DynamicResource S.OptStart}"/>
                    <CheckBox x:Name="PathBox" Style="{StaticResource Option}" IsChecked="True" Content="{DynamicResource S.OptPath}"
                              ToolTip="{DynamicResource S.OptPathTip}"/>
                    <CheckBox x:Name="OpenWithBox" Style="{StaticResource Option}" IsChecked="True" Content="{DynamicResource S.OptOpenWith}"
                              ToolTip="{DynamicResource S.OptOpenWithTip}"/>
                    <CheckBox x:Name="LaunchBox" Style="{StaticResource Option}" IsChecked="True" Content="{DynamicResource S.OptLaunch}"/>
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- Страница 2: ход установки -->
        <Border x:Name="PageProgress" Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" Margin="10,0">
                <TextBlock x:Name="ProgressTitle" Text="{DynamicResource S.Installing}" Style="{DynamicResource Theme.H2}"/>
                <ProgressBar x:Name="Progress" Height="10" Minimum="0" Maximum="1" Margin="0,16,0,10"/>
                <TextBlock x:Name="StepText" Foreground="{DynamicResource Theme.TextDim}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>

        <!-- Страница 3: готово / не получилось -->
        <Border x:Name="PageDone" Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <tl:Icon x:Name="DoneIcon" Kind="Success" Width="56" Height="56" HorizontalAlignment="Center"
                         Foreground="{DynamicResource Theme.Success}"/>
                <TextBlock x:Name="DoneTitle" Style="{DynamicResource Theme.H2}" HorizontalAlignment="Center" Margin="0,14,0,6"/>
                <TextBlock x:Name="DoneText" Foreground="{DynamicResource Theme.TextDim}" TextAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Кнопки -->
        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <Button x:Name="UninstallButton" DockPanel.Dock="Left" Style="{DynamicResource Theme.GhostButton}"
                    Padding="14,8" Click="Uninstall_Click">
                <StackPanel Orientation="Horizontal">
                    <tl:Icon Kind="Trash" Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource S.UninstallButton}"/>
                </StackPanel>
            </Button>
            <StackPanel x:Name="LanguagePanel" DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0"
                        ToolTip="{DynamicResource S.LanguageTip}">
                <tl:Icon Kind="Globe" Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center"
                         Foreground="{DynamicResource Theme.TextDim}"/>
                <ComboBox x:Name="LanguageBox" Width="110" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CloseButton" Content="{DynamicResource S.Cancel}" Style="{StaticResource BarButton}" Click="Close_Click"/>
                <Button x:Name="InstallButton" Style="{DynamicResource Theme.AccentButton}" Padding="22,8" Margin="8,0,0,0"
                        MinWidth="150" IsDefault="True" Click="Install_Click">
                    <StackPanel Orientation="Horizontal">
                        <tl:Icon x:Name="InstallIcon" Kind="Download" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="InstallText"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>
    </Grid>
</tl:ThemedWindow>
